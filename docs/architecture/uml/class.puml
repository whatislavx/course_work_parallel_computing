@startuml class
title Класова діаграма (синхронізовано з 07-domain-model §1)

class Document {
  doc_id: string
  path: string
  text: string
}
class Term {
  value: string
}
class Posting {
  doc_id: string
  term_frequency: int
}
class PostingList {
  term: Term
  postings: Posting[*]
}
class InvertedIndex {
  document_count: int
  term_count: int
  lookup(term) PostingList
}
class IndexBuild {
  threads: int
  state: BuildState
  documents_indexed: int
  time_ms: int
  started_at
  finished_at
}
class IndexStats {
  documents: int
  index_build_time_ms: int
  threads_used: int
}
class SearchQuery {
  query: string
  mode: string
  terms: Term[*]
}
class ExpandedQuery {
  original: string
  expanded_terms: string[*]
}
class SearchResult {
  doc_id: string
  score: number
  snippet: string
}
class SearchResponse {
  results: SearchResult[*]
  time_ms: int
}
class PipelineSession {
  state: SessionState
}
class StageEvent {
  stage: string
  data: object
}

class ThreadPool <<компонент>> {
  submit()
  shutdown()
}
class IndexManager <<компонент>> {
  start_build()
  snapshot()
  state()
}
class SearchService <<компонент>> {
  search()
}
class OllamaClient <<компонент>> {
  generate()
}
class HttpServer <<компонент>>
class WsSearchSession <<компонент>>
class CliClient <<компонент>>

InvertedIndex "1" o-- "*" PostingList
PostingList "1" *-- "*" Posting
Posting "*" --> "1" Document
PostingList "*" --> "1" Term
SearchQuery "1" --> "*" Term
ExpandedQuery ..> SearchQuery : доповнює
SearchResponse "1" *-- "*" SearchResult
PipelineSession "1" --> "*" StageEvent : надсилає

IndexBuild "1" --> "0..1" InvertedIndex : створює
IndexStats ..> IndexBuild : відображає останню успішну
IndexManager "1" --> "0..1" InvertedIndex : активний
IndexManager ..> IndexBuild : керує
IndexBuild ..> ThreadPool : використовує

SearchService ..> InvertedIndex : шукає в активному
SearchService ..> ExpandedQuery
SearchService ..> SearchResponse : формує

WsSearchSession "1" --> "1" PipelineSession
WsSearchSession ..> SearchService
WsSearchSession ..> OllamaClient : розширення через ExpansionHandler
HttpServer ..> IndexManager
HttpServer ..> SearchService
HttpServer ..> OllamaClient : перевірка доступності
CliClient ..> HttpServer : HTTP
@enduml
