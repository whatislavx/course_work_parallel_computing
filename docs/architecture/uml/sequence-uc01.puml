@startuml sequence-uc01
title Запуск системи (UC-01)
participant "Оператор" as OPS
participant "Docker Compose" as Compose
participant "Ollama" as Ollama
participant "Пошуковий сервер" as Srv
OPS -> Compose : docker compose up
Compose -> Ollama : запуск сервісу Ollama
Compose -> Srv : запуск після готовності Ollama
Srv -> Srv : читання і валідація конфігурації
alt конфігурація коректна
  Srv -> Srv : прийом HTTP і WebSocket
  Srv -> Ollama : завантаження моделі
  note right: A1: ollama=false до готовності моделі
  OPS -> Srv : GET /api/health
  Srv --> OPS : 200, ollama: true
else помилка конфігурації (E1)
  Srv --> Compose : код ≠ 0, процес завершується
end
@enduml
