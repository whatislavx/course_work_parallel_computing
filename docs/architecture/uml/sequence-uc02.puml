@startuml sequence-uc02
title Перевірка стану сервісу (UC-02)
participant "Актор (оператор або API)" as ACT
participant "Пошуковий сервер" as Srv
participant "Ollama" as Ollama
ACT -> Srv : GET /api/health
Srv -> Ollama : перевірка доступності з тайм-аутом
alt Ollama відповіла вчасно
  Ollama --> Srv : відповідь
  Srv --> ACT : 200 {status: ok, ollama: true}
else тайм-аут або Ollama недоступна (A1)
  Srv --> ACT : 200 {status: ok, ollama: false}
end
@enduml
