@startuml sequence-uc12
title Зупинка системи (UC-12)
participant "Оператор" as OPS
participant "Docker Compose" as Compose
participant "Пошуковий сервер" as Srv
participant "Пули потоків" as Pool
OPS -> Compose : docker compose down / stop
Compose -> Srv : SIGTERM
Srv -> Srv : припинити приймати нові з'єднання
Srv --> Srv : закрити WS-сесії кодом 1001
Srv -> Pool : скасувати побудову без активації індексу
Srv -> Pool : зупинити пули
alt завершення вклалося в SHUTDOWN_TIMEOUT_MS
  Srv --> Compose : код 0
else тайм-аут (E1)
  Compose -> Srv : SIGKILL
end
@enduml
