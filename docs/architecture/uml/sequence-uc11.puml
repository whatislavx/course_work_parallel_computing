@startuml sequence-uc11
title Бенчмарк навантаження (UC-11)
participant "Дослідник" as BEN
participant "Скрипт навантаження" as Load
participant "Пошуковий сервер" as Srv
BEN -> Load : запуск навантаження
Load -> Srv : GET /api/health; індекс має бути готовим
alt індекс не готовий (E1)
  Load --> BEN : навантаження не стартує
else індекс готовий
  loop для кожного K
    Load -> Srv : прогрів
    par K паралельних клієнтів
      Load -> Srv : UC-05
      Srv --> Load : відповідь
    end
  end
  opt частина запитів завершилась помилкою (A1)
    Load -> Load : частка помилок фіксується
  end
  Load -> Load : throughput, частка помилок, медіана і p95
  Load --> BEN : таблиця і графік
end
@enduml
