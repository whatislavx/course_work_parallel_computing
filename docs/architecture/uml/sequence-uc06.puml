@startuml sequence-uc06
title Пошук із потоковою передачею етапів (UC-06)
participant "WS-клієнт" as WS
participant "Пошуковий сервер" as Srv
participant "Ollama" as Ollama
WS -> Srv : WS connect /ws/search
WS -> Srv : {query}
Srv -> Srv : валідація; перевірка індексу (E1: error invalid; E2: error index_not_ready)
Srv -> Ollama : UC-09: розширення запиту з тайм-аутом (A1: expanded_terms=[])
Srv --> WS : query_expansion {original, expanded_terms}
Srv -> Srv : пошук за термами та розширеними термами
Srv --> WS : keyword_search {results, time_ms}
Srv --> WS : done
WS -> Srv : новий запит або закриття (E4: pipeline_busy)
@enduml
