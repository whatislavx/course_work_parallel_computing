# Параметри конфігурації сервера (NFR-019). Значення за замовчуванням — у src/config/config.hpp.
# Тимчасові значення позначені в коді (OQ-14, OQ-27) і мають бути затверджені.
SERVER_PORT=8080
# DATASET_DIR=/data/docs            # OQ-01: датасет ще не затверджено
DEFAULT_INDEX_THREADS=0             # 0 = кількість логічних процесорів (OQ-07)
MAX_REQUEST_BODY_BYTES=1048576      # тимчасово (OQ-27)
HEALTH_CHECK_TIMEOUT_MS=2000        # тимчасово (OQ-14)
OLLAMA_URL=http://ollama:11434
