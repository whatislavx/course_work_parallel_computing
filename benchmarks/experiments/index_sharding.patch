+        doc = doc_ids_.size();
+        doc_ids_.push_back(std::move(doc_id));
+    }
+
+    // Групування термів за шардами (лічильне сортування), щоб кожен шард блокувався один раз.
+    std::array<std::size_t, kShardCount + 1> offsets{};
+    std::vector<std::size_t> shard_ids(counts.terms.size());
+    for (std::size_t i = 0; i < counts.terms.size(); ++i) {
+        shard_ids[i] = shard_of(counts.terms[i]);
+        ++offsets[shard_ids[i] + 1];
+    }
+    for (std::size_t s = 0; s < kShardCount; ++s) {
