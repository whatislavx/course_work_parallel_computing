+// Частоти термів одного документа: власна TermTable, без std::unordered_map (CON-015).
+struct LocalCounts {
+    std::vector<std::string> terms;
+    std::vector<std::size_t> frequencies;
+};
+
+LocalCounts count_terms(const std::vector<std::string> &tokens) {
+    TermTable seen;
+    LocalCounts counts;
+    for (const std::string &token : tokens) {
+        const std::size_t candidate = counts.terms.size();
+        const std::size_t slot = seen.find_or_insert(token, candidate);
+        if (slot == candidate) {
+            counts.terms.push_back(token);
+            counts.frequencies.push_back(1);
+        } else {
+            ++counts.frequencies[slot];
+        }
+    }
+    return counts;
+}
+
+} // namespace
+
+std::size_t SharedInvertedIndex::shard_of(std::string_view term) {
+    return (TermTable::hash(term) >> 32) % kShardCount;
+}
 
 void SharedInvertedIndex::add_document(std::string doc_id, const std::vector<std::string> &tokens) {
-    std::unique_lock lock(mutex_);
